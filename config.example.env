# Template for ~/.config/comic-worktree-cleanup/env
# Machine-local only. Keep this file out of version control; mode 600 recommended.
# Values may use ~ for the home directory where the tool calls expanduser().

CWC_REPO=~/code/my-project
CWC_TARGET_ROOTS=/home/you/code:/tmp
CWC_MANAGED_CACHE=/home/you/.cache/rust-build-cache
CWC_MOUNTS=/:/tmp
CWC_TIMEZONE=UTC

# Set to owner/repo to enable --respect-leases GitHub checks; leave empty otherwise.
CWC_REMOTE=
